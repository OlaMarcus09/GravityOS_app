# Supabase project (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT verification (Project Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_JWT_AUD=authenticated

# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:3000
WEB_APP_URL=http://localhost:3000

# Comma-separated verified account emails with platform admin access.
# Keep empty unless manual plan administration is enabled for this environment.
SUPER_ADMIN_EMAILS=

# Deferred Soundcharts integration. Both headers are required by Soundcharts.
SOUNDCHARTS_APP_ID=
SOUNDCHARTS_API_KEY=

# Transactional application email. Auth email is configured separately in
# Supabase Custom SMTP; these values drive assignments, approvals, mentions,
# and scheduled deadline reminders through Resend.
RESEND_API_KEY=
EMAIL_FROM="Gravity OS <notifications@gravityos.tech>"
EMAIL_REPLY_TO=support@gravityos.tech
NOTIFICATION_CRON_SECRET=generate-a-long-random-secret

# Promotional trial invitations remain off until a separate operator action.
# The signing key is server-only and must be at least 32 random characters.
TRIAL_INVITATION_SIGNING_KEY=
TRIAL_INVITATION_SENDING_ENABLED=false
TRIAL_INVITATION_CUSTOMER_BATCH_ENABLED=false
# Operator-only test command also needs a separate Resend key that can read
# domains, usage and account-wide suppressions. Never expose it to the web app.
RESEND_AUDIT_API_KEY=

ENVIRONMENT=development

# Payment collection stays disabled in the trial release.
BILLING_CHECKOUT_ENABLED=false

# Optional: credentials for scripts/verify_supabase.py against a test account
API_URL=http://localhost:8000
GRAVITY_TEST_EMAIL=gravity-smoke@example.com
GRAVITY_TEST_PASSWORD=use-a-test-only-password
